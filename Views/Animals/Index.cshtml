@model AnimalIndexViewModel
@{
    ViewData["Title"] = "Animales";
}

<h1 class="mb-4">Animales</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input asp-for="Search" class="form-control" placeholder="Nombre o raza" />
    </div>
    <div class="col-md-2">
        <select asp-for="AnimalType" asp-items="Html.GetEnumSelectList<AnimalType>()" class="form-select">
            <option value="">Todos los tipos</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Sex" asp-items="Html.GetEnumSelectList<AnimalSex>()" class="form-select">
            <option value="">Todos los sexos</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<AnimalStatus>()" class="form-select">
            <option value="">Todos los estados</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Sort" class="form-select">
            <option value="">Ordenar por nombre</option>
            <option value="age">Ordenar por edad</option>
            <option value="entry">Los más recientes primero</option>
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">Ningún animal coincide con los filtros.</p>
}
else
{
    <p class="text-muted">@Model.TotalCount animales encontrados.</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var animal in Model.Items)
        {
            <partial name="_AnimalCard" model="animal" />
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="d-flex align-items-center gap-3 mt-4">
        <a class="btn btn-outline-secondary @(Model.CurrentPage == 1 ? "disabled" : "")"
           asp-action="Index"
           asp-route-search="@Model.Search"
           asp-route-animalType="@Model.AnimalType"
           asp-route-sex="@Model.Sex"
           asp-route-status="@Model.Status"
           asp-route-sort="@Model.Sort"
           asp-route-page="@(Math.Max(1, Model.CurrentPage - 1))">Anterior</a>

        <span class="text-muted">Página @Model.CurrentPage de @Model.TotalPages</span>

        <a class="btn btn-outline-secondary @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
           asp-action="Index"
           asp-route-search="@Model.Search"
           asp-route-animalType="@Model.AnimalType"
           asp-route-sex="@Model.Sex"
           asp-route-status="@Model.Status"
           asp-route-sort="@Model.Sort"
           asp-route-page="@(Math.Min(Model.TotalPages, Model.CurrentPage + 1))">Siguiente</a>
    </nav>
}
