@model AnimalIndexViewModel
@{
    ViewData["Title"] = "Animales";
}

<h1 class="mb-4">Animales</h1>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Ahora mismo no hay ningún animal disponible.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var animal in Model.Items)
        {
            <partial name="_AnimalCard" model="animal" />
        }
    </div>
}
