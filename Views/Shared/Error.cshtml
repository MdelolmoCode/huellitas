@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger mb-4">Algo ha salido mal</h1>

<p>No se ha podido completar la petición. Inténtalo de nuevo más tarde.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted">Identificador de la petición <code>@Model.RequestId</code></p>
}

<a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
