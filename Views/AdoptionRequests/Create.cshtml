@model AdoptionRequestFormViewModel
@{
    ViewData["Title"] = "Solicitud de adopción";
}

<h1 class="mb-4">Solicitar la adopción de @Model.AnimalName</h1>

<form asp-action="Create" asp-route-animalId="@Model.AnimalId" method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="AnimalId" />

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="HasOtherAnimals" class="form-check-input" />
        <label asp-for="HasOtherAnimals" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Enviar solicitud</button>
    <a class="btn btn-outline-secondary"
       asp-controller="Animals" asp-action="Details" asp-route-id="@Model.AnimalId">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
